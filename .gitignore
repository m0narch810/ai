# secrets — never commit
.env
.env.local
*.cookie

# captured data + local runtime artifacts
data/raw/
data/scored/
data/deploy-stage/
data/.loop.pid

# source PDFs for the knowledge base — copyrighted trading docs, stay local
# (knowledge/ is re-extracted from them via npm run extract-knowledge)
pdfs/

# captured API samples (live account data)
fixtures/

# local preview artifact
_board_preview.png

# NOTE: web/dashboard.json IS tracked so the git-connected Netlify site has a board
# to render. It refreshes when you commit a new capture (or via netlify CLI deploy).

# PDF knowledge base — extracted text from local PDFs, not committed (re-extract with npm run extract-knowledge)
knowledge/

# node
node_modules/
dist/
*.log
.DS_Store

# Local Netlify folder
.netlify
